<?xml version="1.0" encoding="UTF-8"?>
<cproject storage_type_id="org.eclipse.cdt.core.XmlProjectDescriptionStorage">
    <storageModule moduleId="org.eclipse.cdt.core.settings">
        <cconfiguration id="com.st.stm32cube.ide.mcu.gnu.managedbuild.configuration.debug.1000">
            <storageModule moduleId="cdtBuildSystem" version="4.0.0">
                <configuration name="Debug" artifactExtension="elf" artifactName="${ProjName}" buildProperties="" description="" id="com.st.stm32cube.ide.mcu.gnu.managedbuild.configuration.debug.1000">
                    <folderInfo id="com.st.stm32cube.ide.mcu.gnu.managedbuild.folderInfo.debug.1000" name="/" resourcePath="">
                        <toolChain id="com.st.stm32cube.ide.mcu.gnu.managedbuild.toolchain.elf.debug.1000" name="ARM Cross GCC" superClass="com.st.stm32cube.ide.mcu.gnu.managedbuild.toolchain.elf.debug">
                            <tool id="com.st.stm32cube.ide.mcu.gnu.managedbuild.tool.c.compiler.1000" name="C Compiler" superClass="com.st.stm32cube.ide.mcu.gnu.managedbuild.tool.c.compiler">
                                <option id="com.st.stm32cube.ide.mcu.gnu.managedbuild.tool.c.compiler.option.definedsymbols.1000" valueType="definedSymbols">
                                    <listOptionValue built_in="false" value="ECLIPSE_DEFINE=1"/>
                                </option>
                                <option id="com.st.stm32cube.ide.mcu.gnu.managedbuild.tool.c.compiler.option.include.paths.1000" valueType="includePath">
                                    <listOptionValue built_in="false" value="include"/>
                                </option>
                                <option id="com.st.stm32cube.ide.mcu.gnu.managedbuild.option.target_mcu.1000" name="MCU" valueType="string" value="STM32F407VGTx"/>
                            </tool>
                            <tool id="com.st.stm32cube.ide.mcu.gnu.managedbuild.tool.c.linker.1000" name="C Linker" superClass="com.st.stm32cube.ide.mcu.gnu.managedbuild.tool.c.linker">
                                <option id="com.st.stm32cube.ide.mcu.gnu.managedbuild.tool.c.linker.option.script.1000" name="Linker script" valueType="string" value="${ProjName}/link.ld"/>
                            </tool>
                        </toolChain>
                    </folderInfo>
                    <sourceEntries>
                        <entry flags="VALUE_WORKSPACE_PATH" kind="sourcePath" name="src"/>
                        <entry flags="VALUE_WORKSPACE_PATH" kind="sourcePath" name="."/>
                    </sourceEntries>
                </configuration>
            </storageModule>
        </cconfiguration>
    </storageModule>
</cproject>
